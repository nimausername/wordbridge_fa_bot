# From @BotFather (/newbot) — never commit a real token
BOT_TOKEN=123456:replace-me

# Postgres (local docker-compose or Coolify)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has @ # % / etc, URL-encode it first.
# Coolify: open the Postgres service → copy the internal URL when the bot
# runs on the same Coolify host; use the public URL only if needed.
DATABASE_URL=postgres://vocab:vocab@localhost:5432/vocab

# Comma-separated Telegram user ids for admin commands (optional)
ADMIN_TELEGRAM_IDS=

# Default timezone for cron wall clock
TZ=Asia/Tehran

# Coolify / Docker: set to 1 only when you want startup to load CEFR seeds.
# Leave 0 (default) if the database is already seeded.
RUN_SEED=0
